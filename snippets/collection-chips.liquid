{%- comment -%}
  Filtros en "burbujas" para páginas de colección: Marca y Orden.
  Usa los filtros nativos de Shopify (?filter.p.vendor=...&sort_by=...), así que la paginación y el conteo siguen funcionando.
{%- endcomment -%}
{%- liquid
  assign vendor_filter = null
  for f in collection.filters
    if f.param_name == 'filter.p.vendor'
      assign vendor_filter = f
    endif
  endfor
  assign current_sort = collection.sort_by
  assign current_vendors = ''
  if vendor_filter
    for v in vendor_filter.active_values
      assign current_vendors = current_vendors | append: v.value | append: ','
    endfor
  endif
  assign current_vendor = current_vendors | split: ',' | first
-%}
{{ 'collection-chips.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign sort_active = false
  if current_sort != blank and current_sort != collection.default_sort_by
    assign sort_active = true
  endif
  assign any_filter = false
  if current_vendor != blank or sort_active
    assign any_filter = true
  endif
-%}
<nav class="collection-chips page-width" aria-label="Filtrar y ordenar productos">
  <div class="collection-chips__group">
    <span class="collection-chips__label">Marca</span>
    {%- if vendor_filter -%}
      {%- for v in vendor_filter.values -%}
        {%- if v.count > 0 or v.active -%}
          <a
            class="collection-chips__chip"
            href="{{ collection.url }}?filter.p.vendor={{ v.value | url_encode }}{% if sort_active %}&sort_by={{ current_sort }}{% endif %}"
            aria-current="{% if v.active %}true{% else %}false{% endif %}"
          >{{ v.label | escape }}</a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>
  <div class="collection-chips__group">
    <span class="collection-chips__label">Ordenar</span>
    <a
      class="collection-chips__chip"
      href="{{ collection.url }}?sort_by=best-selling{% if current_vendor != blank %}&filter.p.vendor={{ current_vendor | url_encode }}{% endif %}"
      aria-current="{% if current_sort == 'best-selling' %}true{% else %}false{% endif %}"
    >Más vendidos</a>
    <a
      class="collection-chips__chip"
      href="{{ collection.url }}?sort_by=price-ascending{% if current_vendor != blank %}&filter.p.vendor={{ current_vendor | url_encode }}{% endif %}"
      aria-current="{% if current_sort == 'price-ascending' %}true{% else %}false{% endif %}"
    >Menor precio</a>
  </div>
  <div class="collection-chips__group collection-chips__group--meta">
    {%- if any_filter -%}
      <a class="collection-chips__chip collection-chips__chip--clear" href="{{ collection.url }}">&#10005; Quitar filtro</a>
    {%- endif -%}
    <span class="collection-chips__count">{{ collection.products_count }} productos</span>
  </div>
</nav>
