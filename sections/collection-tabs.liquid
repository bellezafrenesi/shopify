{% render 'css-defer', file: 'component-card.css' %}
{% render 'css-defer', file: 'component-price.css' %}
{% render 'css-defer', file: 'template-collection.css' %}

{%- style -%}
  .collection-tabs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.6 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.6 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .collection-tabs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  # Solo se muestran pestañas cuya colección tiene productos visibles en la tienda.
  assign valid_tabs = ''
  for block in section.blocks
    if block.settings.collection != blank and block.settings.collection.products.size > 0
      assign valid_tabs = valid_tabs | append: block.id | append: ','
    endif
  endfor
  assign valid_tab_ids = valid_tabs | split: ','
  assign first_tab_id = valid_tab_ids | first
  assign brands = section.settings.brands | split: ','
-%}

{%- if valid_tab_ids.size > 0 -%}
  {% render 'css-defer', file: 'collection-tabs.css' %}

  <div
    class="collection-tabs collection-tabs-{{ section.id }}{% if section.settings.layout == 'carousel' %} collection-tabs--carousel{% endif %} color-{{ section.settings.color_scheme }} gradient"
    data-collection-tabs
    data-limit="{{ section.settings.products_to_show }}"
    data-default-sort="{{ section.settings.default_sort }}"
    data-lazy="{% if section.settings.layout == 'carousel' %}true{% else %}false{% endif %}"
  >
    <div class="page-width">
      <div class="collection-tabs__top">
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-tabs__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        <a class="collection-tabs__view-all link" href="{{ section.blocks.first.settings.collection.url }}" data-view-all>
          {{- section.settings.view_all_label | default: 'Ver todo' | escape -}}
        </a>
      </div>

      <div class="collection-tabs__nav{% if valid_tab_ids.size < 2 %} collection-tabs__nav--single{% endif %}" role="tablist" aria-label="{{ section.settings.heading | escape }}">
        {%- for block in section.blocks -%}
          {%- unless valid_tab_ids contains block.id -%}
            {%- continue -%}
          {%- endunless -%}
          {%- liquid
            assign tab_collection = block.settings.collection
            # Marcas de los productos visibles en la tienda (all_vendors incluye productos no publicados)
            assign tab_vendors = ''
            for tab_product in tab_collection.products
              unless tab_vendors contains tab_product.vendor
                assign tab_vendors = tab_vendors | append: tab_product.vendor | append: ','
              endunless
            endfor
          -%}
          <button
            type="button"
            class="collection-tabs__tab"
            role="tab"
            id="Tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if block.id == first_tab_id %}true{% else %}false{% endif %}"
            tabindex="{% if block.id == first_tab_id %}0{% else %}-1{% endif %}"
            data-url="{{ tab_collection.url }}"
            data-vendors="{{ tab_vendors | escape }}"
            {{ block.shopify_attributes }}
          >
            {{- block.settings.title | default: tab_collection.title | escape -}}
          </button>
        {%- endfor -%}
      </div>

      {%- if section.settings.show_brand_filter or section.settings.show_sort -%}
        <div class="collection-tabs__filters">
          {%- if section.settings.show_brand_filter and brands.size > 0 -%}
            <div class="collection-tabs__filter-group" role="group" aria-label="Filtrar por marca" data-filter="vendor">
              <span class="collection-tabs__filter-label">Marca</span>
              <button type="button" class="collection-tabs__chip" data-value="" aria-pressed="true">Todas</button>
              {%- for brand in brands -%}
                {%- assign brand_name = brand | strip -%}
                {%- if brand_name != blank -%}
                  <button type="button" class="collection-tabs__chip" data-value="{{ brand_name | escape }}" aria-pressed="false">
                    {{- brand_name | escape -}}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
          {%- if section.settings.show_sort -%}
            <div class="collection-tabs__filter-group" role="group" aria-label="Ordenar" data-filter="sort">
              <span class="collection-tabs__filter-label">Ordenar</span>
              <button type="button" class="collection-tabs__chip" data-value="" aria-pressed="true">Destacados</button>
              <button type="button" class="collection-tabs__chip" data-value="best-selling" aria-pressed="false">Más vendidos</button>
              <button type="button" class="collection-tabs__chip" data-value="price-ascending" aria-pressed="false">Menor precio</button>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- unless valid_tab_ids contains block.id -%}
          {%- continue -%}
        {%- endunless -%}
        {%- assign tab_collection = block.settings.collection -%}
        <div
          class="collection-tabs__panel{% if section.settings.layout == 'carousel' and block.id == first_tab_id %} is-loading{% endif %}"
          role="tabpanel"
          id="Panel-{{ section.id }}-{{ forloop.index }}"
          aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
          {% unless block.id == first_tab_id %}
            hidden
          {% endunless %}
        >
          <ul
            class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
            role="list"
            {% if block.id == first_tab_id and section.settings.layout != 'carousel' %}
              data-key="|"
            {% endif %}
          >
            {%- if block.id == first_tab_id and section.settings.layout != 'carousel' -%}
              {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
                <li class="grid__item">
                  {% render 'card-product',
                    card_product: product,
                    media_aspect_ratio: section.settings.image_ratio,
                    show_secondary_image: section.settings.show_secondary_image,
                    show_vendor: false,
                    show_rating: section.settings.show_rating,
                    skip_styles: false,
                    section_id: section.id,
                    lazy_load: true
                  %}
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          <p class="collection-tabs__empty" hidden>
            No hay productos con este filtro.
            <button type="button" class="link" data-clear-filters>Ver todos</button>
          </p>
        </div>
      {%- endfor -%}
      {%- if section.settings.layout == 'carousel' -%}
        <button type="button" class="collection-tabs__arrow collection-tabs__arrow--prev" aria-label="Anterior" data-arrow="-1">&#8249;</button>
        <button type="button" class="collection-tabs__arrow collection-tabs__arrow--next" aria-label="Siguiente" data-arrow="1">&#8250;</button>
      {%- endif -%}
    </div>
  </div>

  <script src="{{ 'collection-tabs.js' | asset_url }}" defer="defer"></script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 3rem 0; text-align: center;">
    Elige colecciones con productos visibles para las pestañas.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Pestañas de colecciones",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que más te gusta"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Presentación",
      "options": [
        { "value": "grid", "label": "Cuadrícula" },
        { "value": "carousel", "label": "Carrusel de una fila (deslizable)" }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "default_sort",
      "label": "Orden inicial",
      "options": [
        { "value": "", "label": "Destacados" },
        { "value": "best-selling", "label": "Más vendidos" },
        { "value": "price-ascending", "label": "Menor precio" }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Productos por pestaña (escritorio)",
      "info": "En celular se muestran 4.",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "adapt", "label": "Adaptar a la imagen" },
        { "value": "portrait", "label": "Vertical (4:5)" },
        { "value": "square", "label": "Cuadrada" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Mostrar segunda imagen al pasar el mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar estrellas de reseñas",
      "default": true
    },
    {
      "type": "header",
      "content": "Filtros"
    },
    {
      "type": "checkbox",
      "id": "show_brand_filter",
      "label": "Filtrar por marca",
      "default": true
    },
    {
      "type": "text",
      "id": "brands",
      "label": "Marcas (separadas por coma)",
      "info": "Escríbelas igual que el \"Proveedor\" del producto en Shopify. Solo aparecen las que existen en la pestaña activa.",
      "default": "Natura,Avon"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Ordenar (Destacados, Más vendidos, Menor precio)",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del enlace \"ver todo\"",
      "default": "Ver todo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio arriba",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio abajo",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título de la pestaña (opcional)",
          "info": "Si lo dejas vacío usa el nombre de la colección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pestañas de colecciones",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
