{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .collection-tabs-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__heading {
    margin: 0 0 1.6rem;
    text-align: center;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__nav {
    display: flex;
    gap: 0.8rem;
    margin: 0 0 2.4rem;
    padding: 0 0 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    justify-content: flex-start;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__nav::-webkit-scrollbar {
    display: none;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__tab {
    flex: 0 0 auto;
    min-height: 4.4rem;
    padding: 0.8rem 2rem;
    border: 0.2rem solid rgb(var(--color-button));
    border-radius: 10rem;
    background: transparent;
    color: rgb(var(--color-button));
    font: inherit;
    font-size: 1.6rem;
    font-weight: 700;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__tab[aria-selected='true'] {
    background: rgb(var(--color-button));
    color: rgb(var(--color-button-text));
  }
  .collection-tabs-{{ section.id }} .collection-tabs__tab:focus-visible {
    outline: 0.3rem solid rgba(var(--color-foreground), 0.6);
    outline-offset: 0.2rem;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__panel[hidden] {
    display: none;
  }
  .collection-tabs-{{ section.id }} .collection-tabs__more {
    margin-top: 2.4rem;
    text-align: center;
  }
  @media screen and (min-width: 750px) {
    .collection-tabs-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    .collection-tabs-{{ section.id }} .collection-tabs__nav {
      justify-content: center;
      flex-wrap: wrap;
      overflow-x: visible;
    }
  }
{%- endstyle -%}

<div class="collection-tabs-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width" data-collection-tabs>
    {%- if section.settings.heading != blank -%}
      <h2 class="collection-tabs__heading h2">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="collection-tabs__nav" role="tablist" aria-label="{{ section.settings.heading | escape }}">
      {%- for block in section.blocks -%}
        <button
          type="button"
          class="collection-tabs__tab"
          role="tab"
          id="Tab-{{ section.id }}-{{ forloop.index }}"
          aria-controls="Panel-{{ section.id }}-{{ forloop.index }}"
          aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
          tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
          {{ block.shopify_attributes }}
        >
          {{- block.settings.title | default: block.settings.collection.title | escape -}}
        </button>
      {%- endfor -%}
    </div>

    {%- assign skip_card_styles = false -%}
    {%- for block in section.blocks -%}
      {%- assign tab_collection = block.settings.collection -%}
      <div
        class="collection-tabs__panel"
        role="tabpanel"
        id="Panel-{{ section.id }}-{{ forloop.index }}"
        aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"
        {% unless forloop.first %}hidden{% endunless %}
      >
        {%- if tab_collection != blank and tab_collection.products.size > 0 -%}
          <ul
            class="grid product-grid grid--2-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
            role="list"
          >
            {%- for product in tab_collection.products limit: section.settings.products_to_show -%}
              <li class="grid__item">
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: false,
                  show_rating: section.settings.show_rating,
                  skip_styles: skip_card_styles,
                  section_id: section.id,
                  lazy_load: true
                %}
              </li>
              {%- assign skip_card_styles = true -%}
            {%- endfor -%}
          </ul>
          <div class="collection-tabs__more">
            <a href="{{ tab_collection.url }}" class="button button--secondary">
              {{- section.settings.view_all_label | default: 'Ver todo' | escape -}}
            </a>
          </div>
        {%- else -%}
          <p class="center">Elige una colección con productos para esta pestaña.</p>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling.querySelector('[data-collection-tabs]');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll('[role="tab"]'));
    var panels = Array.prototype.slice.call(root.querySelectorAll('[role="tabpanel"]'));

    function select(index, focus) {
      tabs.forEach(function (tab, i) {
        var on = i === index;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.setAttribute('tabindex', on ? '0' : '-1');
        if (panels[i]) panels[i].hidden = !on;
        if (on && focus) tab.focus();
      });
    }

    tabs.forEach(function (tab, i) {
      tab.addEventListener('click', function () { select(i, false); });
      tab.addEventListener('keydown', function (e) {
        var next = null;
        if (e.key === 'ArrowRight') next = (i + 1) % tabs.length;
        if (e.key === 'ArrowLeft') next = (i - 1 + tabs.length) % tabs.length;
        if (next !== null) { e.preventDefault(); select(next, true); }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Pestañas de colecciones",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Lo que más te gusta"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 4,
      "label": "Productos por pestaña",
      "default": 8
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "label": "Columnas en escritorio",
      "default": 4
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Proporción de la imagen",
      "options": [
        { "value": "adapt", "label": "Adaptar a la imagen" },
        { "value": "portrait", "label": "Vertical (4:5)" },
        { "value": "square", "label": "Cuadrada" }
      ],
      "default": "portrait"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Mostrar segunda imagen al pasar el mouse",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Mostrar estrellas de reseñas",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "Texto del botón \"ver todo\"",
      "default": "Ver todo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Esquema de color",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio arriba",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Espacio abajo",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Pestaña",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Colección"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Título de la pestaña (opcional)",
          "info": "Si lo dejas vacío usa el nombre de la colección."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pestañas de colecciones",
      "blocks": [
        { "type": "tab" },
        { "type": "tab" },
        { "type": "tab" }
      ]
    }
  ]
}
{% endschema %}
