{%- liquid
  assign slide_count = section.blocks.size
  assign overlay = section.settings.overlay_opacity | divided_by: 100.0
-%}

{%- style -%}
  #HeroCarousel-{{ section.id }} {
    --hc-ratio-desktop: {{ section.settings.ratio_desktop }};
    --hc-ratio-mobile: {{ section.settings.ratio_mobile }};
    --hc-overlay: {{ overlay }};
  }
{%- endstyle -%}

{%- if slide_count > 0 -%}
  <div
    id="HeroCarousel-{{ section.id }}"
    class="hero-carousel"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ section.settings.aria_label | escape }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-interval="{{ section.settings.interval | times: 1000 }}"
  >
    <div class="hero-carousel__track" tabindex="-1">
      {%- for block in section.blocks -%}
        {%- liquid
          assign slide_label = block.settings.alt | default: block.settings.heading
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
          assign slide_loading = 'lazy'
          assign slide_priority = 'low'
          if forloop.first
            assign slide_loading = 'eager'
            assign slide_priority = 'high'
          endif
        -%}
        {%- capture slide_inner -%}
          <span class="hero-carousel__media">
            {%- if block.settings.image != blank -%}
              {% render 'responsive-picture',
                desktop: block.settings.image,
                mobile: block.settings.image_mobile,
                alt: slide_label,
                sizes: '100vw',
                widths: '750, 1100, 1500, 2000, 2400, 3000',
                desktop_max: 3000,
                loading: slide_loading,
                fetchpriority: slide_priority
              %}
            {%- else -%}
              {{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </span>
          {%- if block.settings.heading != blank or block.settings.subheading != blank or block.settings.button_label != blank -%}
            <span class="hero-carousel__content hero-carousel__content--{{ block.settings.text_position }} hero-carousel__content--{{ block.settings.text_color }}">
              {%- if block.settings.heading != blank -%}
                <span class="hero-carousel__heading">{{ block.settings.heading | escape }}</span>
              {%- endif -%}
              {%- if block.settings.subheading != blank -%}
                <span class="hero-carousel__subheading">{{ block.settings.subheading | escape }}</span>
              {%- endif -%}
              {%- if block.settings.button_label != blank -%}
                <span class="hero-carousel__button">{{ block.settings.button_label | escape }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        {%- endcapture -%}

        {%- if has_link -%}
          <a
            href="{{ block.settings.link }}"
            class="hero-carousel__slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} de {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            {{ slide_inner }}
          </a>
        {%- else -%}
          <div
            class="hero-carousel__slide"
            role="group"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} de {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            {{ slide_inner }}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if slide_count > 1 -%}
      <div class="hero-carousel__controls">
        <div class="hero-carousel__dots" role="group" aria-label="Elegir diapositiva">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hero-carousel__dot"
              aria-label="Ir a la diapositiva {{ forloop.index }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
        {%- if section.settings.autoplay -%}
          <button
            type="button"
            class="hero-carousel__toggle"
            aria-label="Pausar la reproducción automática"
            data-label-pause="Pausar la reproducción automática"
            data-label-play="Reanudar la reproducción automática"
          >
            <svg class="hero-carousel__icon-pause" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <rect x="2" y="1" width="3" height="10" rx="1"></rect>
              <rect x="7" y="1" width="3" height="10" rx="1"></rect>
            </svg>
            <svg class="hero-carousel__icon-play" viewBox="0 0 12 12" aria-hidden="true" focusable="false">
              <path d="M3 1.5v9l7.5-4.5z"></path>
            </svg>
          </button>
        {%- endif -%}
      </div>

      <button type="button" class="hero-carousel__arrow hero-carousel__arrow--prev" aria-label="Diapositiva anterior">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
      <button type="button" class="hero-carousel__arrow hero-carousel__arrow--next" aria-label="Diapositiva siguiente">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
      </button>
    {%- endif -%}
  </div>

  {{ 'hero-carousel.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'hero-carousel.js' | asset_url }}" defer="defer"></script>
{%- elsif request.design_mode -%}
  <div class="page-width" style="padding: 4rem 0; text-align: center;">
    Agrega diapositivas a este carrusel.
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Carrusel principal",
  "tag": "section",
  "class": "section hero-carousel-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Tamaño"
    },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "Proporción en escritorio",
      "info": "Imagen recomendada: 2400 × 1000 px (2,4:1).",
      "options": [
        { "value": "12 / 5", "label": "2,4:1 (2400 × 1000)" },
        { "value": "21 / 9", "label": "21:9 (2520 × 1080)" },
        { "value": "16 / 9", "label": "16:9 (1920 × 1080)" },
        { "value": "3 / 1", "label": "3:1 (2400 × 800)" }
      ],
      "default": "12 / 5"
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "Proporción en celular",
      "info": "Imagen recomendada: 1080 × 1350 px (4:5).",
      "options": [
        { "value": "4 / 5", "label": "4:5 (1080 × 1350)" },
        { "value": "3 / 4", "label": "3:4 (1080 × 1440)" },
        { "value": "1 / 1", "label": "1:1 (1080 × 1080)" },
        { "value": "9 / 16", "label": "9:16 (1080 × 1920)" }
      ],
      "default": "4 / 5"
    },
    {
      "type": "header",
      "content": "Movimiento"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Cambiar de diapositiva automáticamente",
      "default": true
    },
    {
      "type": "range",
      "id": "interval",
      "min": 3,
      "max": 10,
      "step": 1,
      "unit": "s",
      "label": "Segundos por diapositiva",
      "default": 5
    },
    {
      "type": "header",
      "content": "Texto sobre la imagen"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "label": "Oscurecer imagen para leer mejor el texto",
      "default": 0
    },
    {
      "type": "text",
      "id": "aria_label",
      "label": "Nombre del carrusel (lectores de pantalla)",
      "default": "Promociones destacadas"
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Diapositiva",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Imagen de escritorio",
          "info": "2400 × 1000 px"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Imagen de celular",
          "info": "1080 × 1350 px. Si no la subes, se usa la de escritorio."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Enlace",
          "info": "Toda la diapositiva es clicable y lleva a este enlace."
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Descripción de la imagen",
          "info": "Para accesibilidad y SEO. Si la dejas vacía usa el título."
        },
        {
          "type": "header",
          "content": "Texto (opcional)"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Título"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subtítulo"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Texto del botón",
          "info": "Es visual: al hacer clic en cualquier parte de la diapositiva se abre el enlace."
        },
        {
          "type": "select",
          "id": "text_position",
          "label": "Posición del texto",
          "options": [
            { "value": "left", "label": "Izquierda" },
            { "value": "center", "label": "Centro" },
            { "value": "right", "label": "Derecha" },
            { "value": "bottom", "label": "Abajo al centro" }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "text_color",
          "label": "Color del texto",
          "options": [
            { "value": "light", "label": "Claro (sobre imagen oscura)" },
            { "value": "dark", "label": "Oscuro (sobre imagen clara)" }
          ],
          "default": "light"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Carrusel principal",
      "blocks": [
        { "type": "slide" },
        { "type": "slide" },
        { "type": "slide" }
      ]
    }
  ]
}
{% endschema %}
