{% layout 'diagnostico' %}
{% raw %}
<style>
.cc{min-height:100vh;background:#fff}
.cc-hero{background:#121212;color:#fff;position:relative;overflow:hidden;min-height:100vh;display:flex;align-items:center}
.cc-hero:before{content:"";position:absolute;right:-140px;top:-100px;width:420px;height:420px;border-radius:50%;background:radial-gradient(circle,rgba(252,93,139,.45),rgba(211,48,106,0) 70%)}
.cc-hero-in{display:grid;gap:24px;align-items:center;padding-top:10px;padding-bottom:36px;position:relative;width:100%}
.cc-hero .dg-top{color:#F1C6C8;justify-content:flex-start;padding-left:0}
.cc-hero h1{color:#fff;font:900 clamp(30px,6.4vw,58px)/1.04 Montserrat;margin:14px 0 12px}
.cc-hero h1 em{font-family:"Playfair Display",serif;font-style:italic;font-weight:700;color:#FC5D8B}
.cc-hero p{color:#d9cfcb;max-width:520px;font-size:17px}
.cc-kpis{display:flex;gap:22px;margin:18px 0 24px;flex-wrap:wrap}
.cc-kpis div{font-size:12px;color:#b9aca8}.cc-kpis b{display:block;font:800 26px Montserrat;color:#fff}
.cc-demo{background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.12);border-radius:22px;padding:18px;max-width:420px;margin:0 auto;width:100%}
.cc-demo svg text{fill:#d9cfcb}
.cc-demo p{text-align:center;font:700 12px Montserrat;letter-spacing:.14em;text-transform:uppercase;color:#FC5D8B;margin:6px 0 0}
@media(min-width:900px){.cc-hero-in{grid-template-columns:1.15fr .85fr;gap:48px}}
@media(max-width:899px){.cc-demo{display:none}}

/* escáner: una pregunta a la vez */
.cc-scan{min-height:100vh;background:linear-gradient(180deg,#fff 0%,#fbf6f2 100%)}
.cc-scan .dg-wrap{max-width:1120px}
.cc-bar{position:sticky;top:0;z-index:5;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid #f0e2d8}
.cc-bar-in{display:flex;align-items:center;gap:12px;padding:10px 0}
.cc-back{border:0;background:#F7ECE2;width:38px;height:38px;border-radius:50%;font-size:18px;color:#121212;flex:none}
.cc-back[disabled]{visibility:hidden}
.cc-mini{width:58px;height:58px;flex:none}
.cc-live-n{font:900 24px Montserrat;min-width:40px;flex:none}
.cc-live-t{flex:1;min-width:0}.cc-live-t small{display:block;font-size:10.5px;color:#7a6a66;text-transform:uppercase;letter-spacing:.1em;font-weight:700}
.cc-live-t span{font-size:13px;color:#121212;font-weight:600;display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.cc-step{font:700 12px Montserrat;color:#7a6a66;flex:none}
.cc-prog{height:3px;background:#f0e2d8}.cc-prog i{display:block;height:100%;width:0;background:#D3306A;transition:width .4s}
.cc-grid{display:grid;gap:28px;padding:26px 0 40px}
@media(min-width:900px){.cc-grid{grid-template-columns:1fr 380px;align-items:start;padding-top:44px}.cc-side{position:sticky;top:96px}.cc-bar .cc-mini,.cc-bar .cc-live-n,.cc-bar .cc-live-t{display:none}.cc-bar-in{justify-content:space-between}}
@media(max-width:899px){.cc-side{display:none}}
.cc-q{animation:ccIn .4s cubic-bezier(.2,.8,.2,1) both;max-width:680px}
.cc-q.out{animation:ccOut .2s ease both}
@keyframes ccIn{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:none}}
@keyframes ccOut{to{opacity:0;transform:translateY(-12px)}}
.cc-sec{font:800 12px Montserrat;letter-spacing:.14em;text-transform:uppercase;color:#D3306A;margin:0 0 8px}
.cc-q h2{font:800 clamp(24px,4.6vw,36px)/1.15 Montserrat;margin:0 0 6px}
.cc-q .sub{color:#7a6a66;margin:0 0 18px;min-height:1em}
.cc-opts{display:grid;gap:10px}
.cc-opt{display:flex;align-items:center;gap:14px;border:1.5px solid #ecdcd2;background:#fff;border-radius:16px;padding:14px 16px;font:600 16px/1.3 Inter;color:#2c2422;text-align:left;transition:border-color .15s,background .15s,transform .15s}
.cc-opt:hover{border-color:#121212;transform:translateX(3px)}
.cc-opt.on{background:#121212;border-color:#121212;color:#fff}
.cc-opt .e{font-size:24px;width:44px;height:44px;border-radius:12px;background:#F7ECE2;display:grid;place-items:center;flex:none}
.cc-opt.on .e{background:rgba(255,255,255,.14)}
.cc-opt .k{margin-left:auto;font:700 11px Montserrat;color:#b9aca8;border:1px solid #ecdcd2;border-radius:6px;padding:3px 7px}
.cc-opt.on .k{color:#fff;border-color:rgba(255,255,255,.3)}
@media(max-width:600px){.cc-opt .k{display:none}}
.cc-name{width:100%;font:22px Inter;padding:16px 18px;border:1.5px solid #ecdcd2;border-radius:16px}
.cc-name:focus{outline:none;border-color:#D3306A;box-shadow:0 0 0 3px rgba(211,48,106,.12)}
.cc-next{margin-top:16px;max-width:360px}
.cc-read{margin-top:20px;display:flex;gap:12px;align-items:center;font-size:14px;color:#5a4a46;background:#F7ECE2;border-radius:14px;padding:12px 14px}
.cc-read b{font:900 20px Montserrat;min-width:44px;text-align:center}
.cc-side .dg-card{padding:20px}
.cc-side h3{font:800 12px Montserrat;letter-spacing:.12em;text-transform:uppercase;color:#7a6a66;margin:0 0 6px}
.cc-side .idx{text-align:center;font:800 16px Montserrat;margin-top:2px}
.cc-side .pf{text-align:center;font-size:13px;color:#7a6a66;margin:2px 0 0}
.cc-gate{max-width:560px;margin:0 auto;padding:10px 0 40px}
.cc-flag{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0 18px}
.cc-flag span{border-radius:99px;padding:7px 12px;font:700 12.5px Montserrat;color:#fff}
.cc-scan-bar{height:3px;width:100%;background:linear-gradient(90deg,transparent,#FC5D8B,transparent);background-size:200% 100%;animation:ccScan 1.4s linear infinite}
@keyframes ccScan{from{background-position:200% 0}to{background-position:-200% 0}}
</style>
<div class="cc" id="cc">
  <section class="cc-hero" id="ccHero"><div class="dg-wrap dg-wide cc-hero-in">
    <div>
      <div class="dg-top">Belleza Frenesí</div>
      <p class="dg-kicker" style="color:#FC5D8B;margin-top:12px">Escáner de belleza por dentro</p>
      <h1>Mira en tiempo real<br>cómo está tu <em>belleza</em>.</h1>
      <p>Respondes una pregunta a la vez y tu mapa de 9 áreas se va dibujando con cada respuesta. Al final te llevas el análisis completo, tu rutina de mañana y tu semana de comidas en PDF.</p>
      <div class="cc-kpis"><div><b>9</b>áreas</div><div><b>15</b>preguntas</div><div><b>2'</b>minutos</div><div><b>$0</b>costo</div></div>
      <button class="dg-btn dg-btn-big" id="ccGo" style="max-width:420px">Empezar el escáner →</button>
      <p style="font-size:13px;color:#9a8a86;margin-top:12px">No es un diagnóstico médico.</p>
    </div>
    <div class="cc-demo" id="ccDemo"></div>
  </div></section>
  <section class="cc-scan" id="ccScan" hidden>
    <div class="cc-bar"><div class="dg-wrap"><div class="cc-bar-in"><button class="cc-back" id="ccBack" aria-label="Volver">←</button><div class="cc-mini" id="ccMini"></div><div class="cc-live-n" id="ccLn">—</div><div class="cc-live-t"><small>Tu índice en vivo</small><span id="ccLt">Responde para empezar</span></div><span class="cc-step" id="ccStep">1/15</span></div></div><div class="cc-prog"><i id="ccProg"></i></div></div>
    <div class="dg-wrap"><div class="cc-grid">
      <div id="ccStage"></div>
      <aside class="cc-side"><div class="dg-card"><h3>Tu mapa en vivo</h3><div id="ccRadar"></div><div class="idx" id="ccIdx"></div><p class="pf" id="ccPf"></p></div></aside>
    </div></div>
  </section>
  <div class="dg-wrap dg-wide"><div class="dg-results" id="ccRes" hidden></div></div>
</div>
<script>
document.addEventListener('DOMContentLoaded',function(){
  var D=window.DIAG; D.variant='c';
  var stage=document.getElementById('ccStage'), back=document.getElementById('ccBack'), N=D.Q.length, i=0;
  var SEC={nombre:'Sobre ti',edad:'Sobre ti',piel:'Lo que ves en el espejo',cabello:'Lo que ves en el espejo',unas:'Lo que ves en el espejo',movilidad:'Cómo se siente tu cuerpo',energia:'Cómo se siente tu cuerpo',descanso:'Cómo se siente tu cuerpo',agua:'Tus hábitos',proteina:'Tus hábitos',lacteos:'Tus hábitos',frutas:'Tus hábitos',sol:'Tus hábitos',movimiento:'Tus hábitos',meta:'Tu objetivo'};
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
  // radar de ejemplo en la portada
  var demo={piel:62,cabello:58,unas:50,movilidad:60,energia:60,hidratacion:40,nutricion:62,descanso:64,sol:55};
  document.getElementById('ccDemo').innerHTML=D.radar(demo,320)+'<p>Así se ve tu mapa</p>';
  function live(){
    var s=D.scores(), idx=D.index(s), any=Object.keys(s).some(function(k){return s[k]!=null});
    document.getElementById('ccRadar').innerHTML=D.radar(s,340);
    document.getElementById('ccMini').innerHTML=D.radar(s,128,1);
    document.getElementById('ccIdx').innerHTML=any?'Índice: <span style="color:'+D.color(idx)+'">'+idx+'/100</span>':'<span style="font-weight:400;color:#7a6a66">Tu índice aparece al responder</span>';
    document.getElementById('ccPf').textContent=any?D.profile(idx).n:'';
    var ln=document.getElementById('ccLn');ln.textContent=any?idx:'—';ln.style.color=D.color(any?idx:null);
    document.getElementById('ccLt').textContent=any?D.profile(idx).n:'Responde para empezar';
    document.getElementById('ccStep').textContent=Math.min(i+1,N)+'/'+N;
    document.getElementById('ccProg').style.width=Math.round(i/N*100)+'%';
    back.disabled=i===0;
  }
  function go(n){var c=stage.firstChild;if(c){c.classList.add('out');setTimeout(function(){i=n;draw()},180)}else{i=n;draw()}}
  function draw(){
    if(i>=N) return finish();
    live(); var q=D.Q[i], c=document.createElement('div'); c.className='cc-q';
    var h='<p class="cc-sec">'+SEC[q.id]+'</p><h2>'+q.t+'</h2><p class="sub">'+(q.s||'')+'</p>';
    if(q.type==='text') h+='<input class="cc-name" id="ccName" placeholder="'+q.ph+'" maxlength="40" autocomplete="given-name" value="'+esc(D.ans.nombre||'')+'"><button class="dg-btn dg-btn-big cc-next" id="ccNx">Continuar →</button>';
    else{ h+='<div class="cc-opts">'+q.o.map(function(o,ix){var on=q.multi?(D.ans.meta||[]).indexOf(o[2])>-1:D.ans[q.id]===ix;return '<button type="button" class="cc-opt'+(on?' on':'')+'" data-i="'+ix+'"><span class="e">'+o[1]+'</span>'+o[0]+'<span class="k">'+String.fromCharCode(65+ix)+'</span></button>'}).join('')+'</div>';
      if(q.multi) h+='<button class="dg-btn dg-btn-big cc-next" id="ccNx">Ver mi análisis →</button>'; }
    if(q.a) h+='<div class="cc-read" id="ccRead" hidden></div>';
    c.innerHTML=h; stage.innerHTML=''; stage.appendChild(c); window.scrollTo(0,0);
    if(q.type==='text'){var inp=c.querySelector('#ccName');setTimeout(function(){inp.focus({preventScroll:true})},200);var nx=function(){var v=inp.value.trim();if(!v){inp.focus();return}D.answer('nombre',v);go(i+1)};c.querySelector('#ccNx').onclick=nx;inp.onkeydown=function(e){if(e.key==='Enter')nx()};return}
    [].forEach.call(c.querySelectorAll('.cc-opt'),function(b){b.onclick=function(){pick(q,c,+b.dataset.i,b)}});
    if(q.multi) c.querySelector('#ccNx').onclick=function(){if(!(D.ans.meta||[]).length)D.ans.meta=[];D.track('respuesta','meta');go(i+1)};
  }
  function pick(q,c,ix,b){
    if(q.multi){var m=D.ans.meta||[],v=q.o[ix][2],p=m.indexOf(v);p>-1?m.splice(p,1):m.push(v);D.ans.meta=m;b.classList.toggle('on');return}
    [].forEach.call(c.querySelectorAll('.cc-opt'),function(x){x.classList.remove('on')});b.classList.add('on');D.answer(q.id,ix);live();
    var r=c.querySelector('#ccRead');
    if(r){var area=q.a==='mov2'?'movilidad':q.a,v=D.scores()[area];r.hidden=false;r.innerHTML='<b style="color:'+D.color(v)+'">'+v+'</b><span>'+D.AREAS[area].i+' '+D.AREAS[area].n+': '+D.label(v).toLowerCase()+'. Tu mapa se actualizó.</span>'}
    setTimeout(function(){go(i+1)},r?900:300);
  }
  document.addEventListener('keydown',function(e){ // atajos A, B, C… en escritorio
    if(document.getElementById('ccScan').hidden||e.target.tagName==='INPUT')return;
    var k=e.key.toUpperCase().charCodeAt(0)-65, c=stage.firstChild; if(!c||e.key.length!==1)return;
    var b=c.querySelectorAll('.cc-opt')[k]; if(b) b.click();
  });
  function finish(){
    i=N; live(); document.querySelector('.cc-bar').style.display='none';
    var s=D.scores(), idx=D.index(s), lows=D.lows(s,3), nm=esc((D.ans.nombre||'').split(' ')[0]);
    stage.innerHTML='<div class="cc-gate"><div class="cc-scan-bar"></div><p class="dg-kicker" style="margin-top:14px">Escaneo completo</p><h2 style="font:800 26px/1.2 Montserrat">'+nm+', ya tenemos tu análisis.</h2><div class="dg-card" style="margin:14px 0"><div style="max-width:240px;margin:0 auto">'+D.gauge(idx,200)+'</div><p style="text-align:center;font-weight:700;margin:4px 0 0">'+esc(D.profile(idx).n)+'</p></div><p>Tus áreas a trabajar:</p><div class="cc-flag">'+lows.map(function(k){return '<span style="background:'+D.color(s[k])+'">'+D.AREAS[k].i+' '+D.AREAS[k].n+' · '+s[k]+'</span>'}).join('')+'</div><p style="margin-bottom:14px">Déjanos tu correo para enviarte el PDF completo: por qué pasa cada cosa, tu rutina de mañana y tu semana de comidas.</p><div id="ccMail"></div></div>';
    window.scrollTo(0,0);
    document.getElementById('ccMail').appendChild(D.emailForm(function(){document.getElementById('ccScan').hidden=true;D.renderResults(document.getElementById('ccRes'));window.scrollTo(0,0)}));
  }
  back.onclick=function(){if(i>0)go(i-1)};
  document.getElementById('ccGo').onclick=function(){document.getElementById('ccHero').hidden=true;document.getElementById('ccScan').hidden=false;D.track('inicio','c');draw()};
});
</script>
{% endraw %}
