{% layout 'diagnostico' %}
{% raw %}
<style>
.cc{min-height:100vh;background:#fff}
.cc-hero{background:#121212;color:#fff;padding:0 0 30px;position:relative;overflow:hidden}
.cc-hero:before{content:"";position:absolute;right:-120px;top:-80px;width:360px;height:360px;border-radius:50%;background:radial-gradient(circle,rgba(252,93,139,.45),rgba(211,48,106,0) 70%)}
.cc-hero .dg-top{color:#F1C6C8;justify-content:flex-start;padding-left:0}
.cc-hero h1{color:#fff;font:900 clamp(30px,8vw,50px)/1.04 Montserrat;margin:16px 0 12px;position:relative}
.cc-hero h1 em{font-family:"Playfair Display",serif;font-style:italic;font-weight:700;color:#FC5D8B}
.cc-hero p{color:#d9cfcb;max-width:520px;position:relative}
.cc-kpis{display:flex;gap:18px;margin:18px 0 22px;position:relative}
.cc-kpis div{font-size:12px;color:#b9aca8}.cc-kpis b{display:block;font:800 24px Montserrat;color:#fff}
.cc-body{display:grid;gap:22px;padding:22px 0 40px}
@media(min-width:900px){.cc-body{grid-template-columns:1fr 340px;align-items:start}.cc-side{position:sticky;top:16px}}
.cc-live{position:sticky;top:0;z-index:4;background:rgba(255,255,255,.96);backdrop-filter:blur(8px);border-bottom:1px solid #ecdcd2;padding:10px 0}
.cc-live .dg-wrap{display:flex;align-items:center;gap:12px}
.cc-live-n{font:900 26px Montserrat;min-width:54px}
.cc-live-t{flex:1}.cc-live-t small{display:block;font-size:11px;color:#7a6a66;text-transform:uppercase;letter-spacing:.1em;font-weight:700}
.cc-live-t span{font-size:13px;color:#121212;font-weight:600}
.cc-live-p{font:700 12px Montserrat;color:#7a6a66}
@media(min-width:900px){.cc-live{display:none}}
.cc-side .dg-card{padding:16px}
.cc-side h3{font-size:14px;letter-spacing:.08em;text-transform:uppercase;color:#7a6a66}
.cc-sec{margin:0 0 8px}
.cc-sec>h2{font:800 13px Montserrat;letter-spacing:.14em;text-transform:uppercase;color:#D3306A;margin:18px 0 8px}
.cc-item{background:#fff;border:1.5px solid #f0e2d8;border-radius:16px;padding:16px;margin-bottom:12px;transition:border-color .2s,box-shadow .2s}
.cc-item.done{border-color:#F1C6C8}
.cc-item.cur{box-shadow:0 0 0 3px rgba(211,48,106,.15);border-color:#D3306A}
.cc-item h3{font:700 16px/1.3 Inter;color:#121212;margin:0 0 4px}
.cc-item .sub{font-size:13px;color:#7a6a66;margin:0 0 10px}
.cc-seg{display:flex;flex-wrap:wrap;gap:8px}
.cc-seg button{flex:1 1 140px;border:1.5px solid #ecdcd2;background:#fbf7f4;border-radius:12px;padding:11px 10px;font:600 14px/1.25 Inter;color:#3b2f2c;text-align:left;display:flex;gap:8px;align-items:center}
.cc-seg button.on{background:#121212;border-color:#121212;color:#fff}
.cc-item input[type=text]{width:100%;font:17px Inter;padding:13px 14px;border:1.5px solid #ecdcd2;border-radius:12px}
.cc-item input[type=text]:focus{outline:none;border-color:#D3306A}
.cc-finish{position:sticky;bottom:0;padding:14px 0 calc(14px + env(safe-area-inset-bottom));background:linear-gradient(180deg,rgba(255,255,255,0),#fff 30%);z-index:3}
.cc-gate{max-width:560px;margin:0 auto;padding:10px 0 40px}
.cc-flag{display:flex;gap:10px;flex-wrap:wrap;margin:12px 0 18px}
.cc-flag span{border-radius:99px;padding:7px 12px;font:700 12.5px Montserrat;color:#fff}
</style>
<div class="cc" id="cc">
  <section class="cc-hero" id="ccHero"><div class="dg-wrap">
    <div class="dg-top">Belleza Frenesí</div>
    <p class="dg-kicker" style="color:#FC5D8B;margin-top:12px">Escáner de belleza por dentro</p>
    <h1>Mira en tiempo real<br>cómo está tu <em>belleza</em>.</h1>
    <p>A medida que respondes, tu mapa de 9 áreas se va dibujando. Al final te llevas el análisis completo, tu rutina de mañana y tu semana de comidas en PDF.</p>
    <div class="cc-kpis"><div><b>9</b>áreas</div><div><b>15</b>preguntas</div><div><b>2'</b>minutos</div><div><b>$0</b>costo</div></div>
    <a class="dg-btn dg-btn-big" href="#ccForm" id="ccGo" style="max-width:420px">Empezar el escáner ↓</a>
  </div></section>
  <div class="cc-live" id="ccLive" hidden><div class="dg-wrap"><div class="cc-live-n" id="ccLn">—</div><div class="cc-live-t"><small>Tu índice en vivo</small><span id="ccLt">Responde para ver tu índice</span></div><div class="cc-live-p" id="ccLp">0/15</div></div></div>
  <div class="dg-wrap">
    <div class="cc-body" id="ccBody">
      <div id="ccForm"></div>
      <aside class="cc-side"><div class="dg-card"><h3>Tu mapa en vivo</h3><div id="ccRadar"></div><div id="ccIdx" style="text-align:center;font:800 15px Montserrat;margin-top:4px"></div></div></aside>
    </div>
    <div class="dg-results" id="ccRes" hidden></div>
  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded',function(){
  var D=window.DIAG; D.variant='c';
  var form=document.getElementById('ccForm'), radar=document.getElementById('ccRadar');
  var GROUPS=[['Sobre ti',['nombre','edad']],['Lo que ves en el espejo',['piel','cabello','unas']],['Cómo se siente tu cuerpo',['movilidad','energia','descanso']],['Tus hábitos',['agua','proteina','lacteos','frutas','sol','movimiento']],['Tu objetivo',['meta']]];
  var byId={};D.Q.forEach(function(q){byId[q.id]=q});
  function esc(t){return String(t).replace(/[&<>"]/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]})}
  var h='';
  GROUPS.forEach(function(g){h+='<div class="cc-sec"><h2>'+g[0]+'</h2>';g[1].forEach(function(id){var q=byId[id];
    h+='<div class="cc-item" id="it-'+id+'"><h3>'+q.t+'</h3>'+(q.s?'<p class="sub">'+q.s+'</p>':'');
    if(q.type==='text')h+='<input type="text" data-q="'+id+'" placeholder="'+q.ph+'" maxlength="40" autocomplete="given-name">';
    else h+='<div class="cc-seg" data-q="'+id+'">'+q.o.map(function(o,ix){return '<button type="button" data-i="'+ix+'"><span>'+o[1]+'</span>'+o[0]+'</button>'}).join('')+'</div>';
    h+='</div>'});h+='</div>'});
  h+='<div class="cc-finish"><button class="dg-btn dg-btn-big" id="ccDone" disabled>Responde las 15 para ver tu análisis</button></div>';
  form.innerHTML=h;
  function update(){
    var s=D.scores(), idx=D.index(s), n=0;D.Q.forEach(function(q){var v=D.ans[q.id];if(v!=null&&v!==''&&!(Array.isArray(v)&&!v.length))n++});
    radar.innerHTML=D.radar(s,300);
    var any=Object.keys(s).some(function(k){return s[k]!=null});
    document.getElementById('ccIdx').innerHTML=any?'Índice: <span style="color:'+D.color(idx)+'">'+idx+'/100</span>':'<span class="dg-muted" style="font-weight:400">Empieza a responder</span>';
    document.getElementById('ccLn').textContent=any?idx:'—';document.getElementById('ccLn').style.color=D.color(any?idx:null);
    document.getElementById('ccLt').textContent=any?D.profile(idx).n:'Responde para ver tu índice';
    document.getElementById('ccLp').textContent=n+'/15';
    var b=document.getElementById('ccDone');b.disabled=n<D.Q.length;b.textContent=n<D.Q.length?'Te faltan '+(D.Q.length-n)+' preguntas':'Ver mi análisis completo →';
  }
  function next(id){var ix=D.Q.findIndex(function(q){return q.id===id});for(var k=ix+1;k<D.Q.length;k++){var q=D.Q[k];if(D.ans[q.id]==null){var el=document.getElementById('it-'+q.id);[].forEach.call(document.querySelectorAll('.cc-item.cur'),function(x){x.classList.remove('cur')});el.classList.add('cur');var y=el.getBoundingClientRect().top+window.scrollY-90;window.scrollTo({top:y,behavior:'smooth'});return}}}
  form.addEventListener('click',function(e){var b=e.target.closest('.cc-seg button');if(!b)return;var seg=b.parentNode,id=seg.dataset.q,q=byId[id],ix=+b.dataset.i;
    if(q.multi){var m=D.ans.meta||[],v=q.o[ix][2],p=m.indexOf(v);p>-1?m.splice(p,1):m.push(v);D.ans.meta=m.length?m:null;b.classList.toggle('on')}
    else{[].forEach.call(seg.children,function(x){x.classList.remove('on')});b.classList.add('on');D.answer(id,ix)}
    document.getElementById('it-'+id).classList.add('done');update();if(!q.multi)setTimeout(function(){next(id)},220)});
  form.addEventListener('input',function(e){if(e.target.dataset.q==='nombre'){var v=e.target.value.trim();D.ans.nombre=v||null;document.getElementById('it-nombre').classList.toggle('done',!!v);update()}});
  form.addEventListener('keydown',function(e){if(e.key==='Enter'&&e.target.dataset.q==='nombre'){e.preventDefault();next('nombre')}});
  var started=false;function start(){if(started)return;started=true;document.getElementById('ccLive').hidden=false;D.track('inicio','c')}
  document.getElementById('ccGo').addEventListener('click',function(e){e.preventDefault();start();var el=document.getElementById('it-nombre');el.classList.add('cur');window.scrollTo({top:el.getBoundingClientRect().top+window.scrollY-90,behavior:'smooth'});setTimeout(function(){el.querySelector('input').focus({preventScroll:true})},500)});
  form.addEventListener('focusin',start,{once:true});form.addEventListener('click',start,{once:true});
  document.getElementById('ccDone').onclick=function(){
    var s=D.scores(), idx=D.index(s), lows=D.lows(s,3), nm=esc((D.ans.nombre||'').split(' ')[0]);
    document.getElementById('ccBody').innerHTML='<div class="cc-gate"><p class="dg-kicker">Escaneo completo</p><h2 style="font:800 26px/1.2 Montserrat">'+nm+', ya tenemos tu análisis.</h2><div class="dg-card" style="margin:14px 0">'+D.gauge(idx,200)+'<p style="text-align:center;font-weight:700;margin:4px 0 0">'+esc(D.profile(idx).n)+'</p></div><p>Tus áreas a trabajar:</p><div class="cc-flag">'+lows.map(function(k){return '<span style="background:'+D.color(s[k])+'">'+D.AREAS[k].i+' '+D.AREAS[k].n+' · '+s[k]+'</span>'}).join('')+'</div><p style="margin-bottom:14px">Déjanos tu correo para enviarte el PDF completo: por qué pasa cada cosa, tu rutina de mañana y tu semana de comidas.</p><div id="ccMail"></div></div>';
    document.getElementById('ccLive').hidden=true;window.scrollTo(0,document.getElementById('ccBody').offsetTop-10);
    document.getElementById('ccMail').appendChild(D.emailForm(function(){document.getElementById('ccBody').hidden=true;document.getElementById('ccHero').hidden=true;D.renderResults(document.getElementById('ccRes'));window.scrollTo(0,0)}));
  };
  update();
});
</script>
{% endraw %}
